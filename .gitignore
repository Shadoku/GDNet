# Godot 4 editor cache (regenerated by `godot --import`)
.godot/
*.tmp

# Keep *.import and *.uid sidecar files committed: Godot needs them to resolve
# resources and script references consistently across machines.

# Exported builds
/build/
/export/

# Test output (the test stages write junit-<stage>.xml)
junit*.xml

# OS / tooling
.DS_Store
Thumbs.db
__pycache__/

# gdnet (docs/PLAN_NETCODE.md D7): build outputs are never committed
rust/target/
addons/gdnet/bin/

# tools/check.py's per-checkout state (shard times)
.check/

# Claude Code agent worktrees
.claude/worktrees/

# GodotSteam (WP23): installed by tools/install_godotsteam.sh, never committed; Steam's app id file
addons/godotsteam/
steam_appid.txt
