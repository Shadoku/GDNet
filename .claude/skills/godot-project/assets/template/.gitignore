# Godot 4 editor cache (regenerated by `godot --import`)
.godot/
*.tmp

# Keep *.import and *.uid sidecar files committed: Godot needs them to resolve
# resources and script references consistently across machines.

# Exported builds
/build/
/export/

# Test output (the test stages write junit-<stage>.xml)
junit*.xml

# tools/check.py's per-checkout state (shard times)
.check/

# OS / tooling
.DS_Store
Thumbs.db
__pycache__/
