[gd_scene format=3]

[ext_resource type="Script" path="res://addons/gdnet/connect/connect_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://addons/gdnet/connect/net_connect.gd" id="2_connect"]

[node name="ConnectMenu" type="VBoxContainer"]
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -120.0
offset_top = -120.0
offset_right = 120.0
offset_bottom = 120.0
script = ExtResource("1_menu")

[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "gdnet"
horizontal_alignment = 1

[node name="Host" type="Button" parent="."]
layout_mode = 2
text = "Host"

[node name="HostSteam" type="Button" parent="."]
visible = false
layout_mode = 2
text = "Host on Steam"

[node name="CodeRow" type="HBoxContainer" parent="."]
visible = false
layout_mode = 2

[node name="Code" type="Label" parent="CodeRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Copy" type="Button" parent="CodeRow"]
layout_mode = 2
text = "Copy"

[node name="Address" type="LineEdit" parent="."]
layout_mode = 2
text = "127.0.0.1"
placeholder_text = "address or join code"

[node name="Join" type="Button" parent="."]
layout_mode = 2
text = "Join"

[node name="Offline" type="Button" parent="."]
layout_mode = 2
text = "Offline"

[node name="Status" type="Label" parent="."]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
autowrap_mode = 3

[node name="Connect" type="Node" parent="."]
script = ExtResource("2_connect")
